# .env.example

# IMAP Configuration
APPLENOTES_IMAP_SERVER=imap.example.com
APPLENOTES_IMAP_USERNAME=user@example.com
APPLENOTES_IMAP_FOLDER=Notes
# APPLENOTES_IMAP_PASSWORD should be set by the user (it is sensitive)

# Storage Configuration
APPLENOTES_NOTES_DIR=./notes/
APPLENOTES_INDENT_SPACES=4
