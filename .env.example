# .env.example

# IMAP Configuration
APPLETEXTNOTES_IMAP_SERVER=imap.example.com
APPLETEXTNOTES_IMAP_USERNAME=user@example.com
APPLETEXTNOTES_IMAP_FOLDER=Notes
# APPLETEXTNOTES_IMAP_PASSWORD should be set by the user (it is sensitive)

# Storage Configuration
APPLETEXTNOTES_NOTES_DIR=./notes/
APPLETEXTNOTES_INDENT_SPACES=4
